
APP_NAME=Open Agent AWS
APP_VERSION=0.1.0

# development | testing | production
ENVIRONMENT=development

# true | false
DEBUG=true

HOST=0.0.0.0
PORT=8000



GROQ_API_KEY=

# Model used by the agent
GROQ_MODEL=openai/gpt-oss-120b

# LLM generation settings
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120



AGENT_MAX_STEPS=20

# Maximum time allowed for a single agent step
AGENT_STEP_TIMEOUT=120



DATABASE_URL=


QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=agent_memory




AWS_REGION=ap-south-1


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

AWS_EC2_INSTANCE_ID=
AWS_EC2_AMI_ID=
AWS_EC2_INSTANCE_TYPE=t3.micro




S3_BUCKET_NAME=



TAVILY_API_KEY=



PLAYWRIGHT_HEADLESS=true